# 复制为 .env 后修改。.env 已在 .gitignore 中，不要提交。
# Web 控制台登录用（两个机器人共用）
FREQTRADE__API_SERVER__USERNAME=admin
FREQTRADE__API_SERVER__PASSWORD=change-me
# 随机长字符串：python3 -c "import secrets;print(secrets.token_hex(32))"
FREQTRADE__API_SERVER__JWT_SECRET_KEY=change-me-too
FREQTRADE__API_SERVER__WS_TOKEN=change-me-ws

# 交易所：binance / okx / bybit ...（dry-run 模拟盘不需要 Key）
FREQTRADE__EXCHANGE__NAME=binance
# 实盘才填。Key 只开「读取+交易」，绝不开「提现」，并绑定服务器 IP 白名单。
# FREQTRADE__EXCHANGE__KEY=
# FREQTRADE__EXCHANGE__SECRET=
# FREQTRADE__EXCHANGE__PASSWORD=   # OKX 的 passphrase

# QQ 群推送（QQ 机器人（OneBot）的 Aten 专用推送入口；目标群在机器人侧配置）。两项缺一则不推送。
# ATEN_QQ_PUSH_URL=https://<机器人域名>/integrations/aten/notifications
# ATEN_QQ_PUSH_TOKEN=
# ATEN_DAILY_REPORT_HOUR=8   # 每日决策推送在该小时的 15 分（北京时间）
